{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.isaiahdupree.sonanceeq",
  "version": "0.1.0",
  "compatibility": ">=12.0.1",
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "sdk": 3,
  "brandColor": "#4D5CFF",
  "name": {
    "en": "Sonance EQ"
  },
  "description": {
    "en": "Control safe EQ presets on Sonance PowerZone amplifier outputs."
  },
  "category": "music",
  "tags": {
    "en": [
      "Sonance",
      "PowerZone",
      "equalizer",
      "audio",
      "DSP"
    ]
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "permissions": [],
  "author": {
    "name": "Isaiah Dupree"
  },
  "source": "https://github.com/IsaiahDupree/EqualizerForMac",
  "support": "https://github.com/IsaiahDupree/EqualizerForMac/issues",
  "bugs": {
    "url": "https://github.com/IsaiahDupree/EqualizerForMac/issues"
  },
  "flow": {
    "actions": [
      {
        "title": {
          "en": "Set EQ preset"
        },
        "titleFormatted": {
          "en": "Set EQ preset to [[preset]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=powerzone-output"
          },
          {
            "type": "dropdown",
            "name": "preset",
            "title": {
              "en": "Preset"
            },
            "values": [
              {
                "id": "flat",
                "title": {
                  "en": "Flat"
                }
              },
              {
                "id": "bass_boost",
                "title": {
                  "en": "Bass Boost"
                }
              },
              {
                "id": "treble",
                "title": {
                  "en": "Treble"
                }
              },
              {
                "id": "vocal",
                "title": {
                  "en": "Vocal"
                }
              },
              {
                "id": "loudness",
                "title": {
                  "en": "Loudness"
                }
              },
              {
                "id": "warm_room",
                "title": {
                  "en": "Warm Room"
                }
              },
              {
                "id": "night",
                "title": {
                  "en": "Night"
                }
              },
              {
                "id": "small_speaker",
                "title": {
                  "en": "Small Speaker"
                }
              },
              {
                "id": "cinema",
                "title": {
                  "en": "Cinema"
                }
              }
            ]
          }
        ],
        "id": "set_preset"
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "PowerZone output"
      },
      "class": "speaker",
      "connectivity": [
        "lan"
      ],
      "capabilities": [
        "sonance_eq_preset"
      ],
      "icon": "/drivers/powerzone-output/assets/icon.svg",
      "images": {
        "small": "/drivers/powerzone-output/assets/images/small.png",
        "large": "/drivers/powerzone-output/assets/images/large.png",
        "xlarge": "/drivers/powerzone-output/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "powerzone-output",
      "settings": [
        {
          "id": "host",
          "type": "text",
          "label": {
            "en": "PowerZone host"
          },
          "hint": {
            "en": "Private LAN hostname or address. Public targets are rejected."
          },
          "value": "powerzone.local"
        },
        {
          "id": "port",
          "type": "number",
          "label": {
            "en": "Installer API port"
          },
          "value": 7621,
          "attr": {
            "min": 1,
            "max": 65535
          }
        }
      ]
    }
  ],
  "capabilities": {
    "sonance_eq_preset": {
      "type": "enum",
      "title": {
        "en": "EQ preset"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "icon": "/assets/icons/equalizer.svg",
      "values": [
        {
          "id": "flat",
          "title": {
            "en": "Flat"
          }
        },
        {
          "id": "bass_boost",
          "title": {
            "en": "Bass Boost"
          }
        },
        {
          "id": "treble",
          "title": {
            "en": "Treble"
          }
        },
        {
          "id": "vocal",
          "title": {
            "en": "Vocal"
          }
        },
        {
          "id": "loudness",
          "title": {
            "en": "Loudness"
          }
        },
        {
          "id": "warm_room",
          "title": {
            "en": "Warm Room"
          }
        },
        {
          "id": "night",
          "title": {
            "en": "Night"
          }
        },
        {
          "id": "small_speaker",
          "title": {
            "en": "Small Speaker"
          }
        },
        {
          "id": "cinema",
          "title": {
            "en": "Cinema"
          }
        }
      ]
    }
  },
  "discovery": {
    "powerzone": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "pasconnect",
        "protocol": "tcp"
      },
      "id": "{{name}}",
      "conditions": [
        [
          {
            "field": "txt.api_version",
            "match": {
              "type": "regex",
              "value": "^.+$"
            }
          }
        ]
      ]
    }
  }
}