#!/bin/bash
# Sonance EQ pre-commit hook: regenerate the project and run the test suite when code changes.
# Skip with:  SKIP_SONANCE_TESTS=1 git commit …   or   git commit --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [ "${SKIP_SONANCE_TESTS:-0}" = "1" ]; then
  echo "[pre-commit] skipped (SKIP_SONANCE_TESTS=1)"
  exit 0
fi

# Only run for Swift / project changes — keep doc-only commits fast.
# Capture first: under pipefail, grep -q can close its pipe early and make Git
# report SIGPIPE, incorrectly treating staged Swift files as a doc-only commit.
sonance_changed_sources="$(git diff --cached --name-only -- '*.swift' project.yml)"
if [ -z "$sonance_changed_sources" ]; then
  echo "[pre-commit] no Swift/project changes — skipping tests"
  exit 0
fi

if ! command -v xcodegen >/dev/null 2>&1; then
  echo "[pre-commit] xcodegen not found — skipping (install: brew install xcodegen)"
  exit 0
fi

echo "[pre-commit] xcodegen generate + xcodebuild test …"
xcodegen generate >/dev/null
sonance_build_args=(test
      -project SonanceEQ.xcodeproj -scheme SonanceEQ
      -destination 'platform=macOS,arch=arm64'
      -jobs 1 -parallel-testing-enabled NO -quiet
      'OTHER_SWIFT_FLAGS=$(inherited) -j1')
# Reuse an explicitly selected, pinned SDK checkout when a fresh worktree's package
# checkout fails. Xcode still validates Package.resolved; no tests are excluded.
if [ -n "${SONANCE_SOURCE_PACKAGES_DIR:-}" ]; then
  if [ ! -d "$SONANCE_SOURCE_PACKAGES_DIR" ]; then
    echo "[pre-commit] selected source package cache does not exist"
    exit 1
  fi
  sonance_build_args+=(-clonedSourcePackagesDirPath "$SONANCE_SOURCE_PACKAGES_DIR"
                      -disableAutomaticPackageResolution)
fi
if [ -n "${SONANCE_DERIVED_DATA_DIR:-}" ]; then
  sonance_build_args+=(-derivedDataPath "$SONANCE_DERIVED_DATA_DIR")
fi
if xcodebuild "${sonance_build_args[@]}"; then
  echo "[pre-commit] ✓ tests passed"
else
  echo "[pre-commit] ✗ tests failed — commit aborted (use --no-verify to override)"
  exit 1
fi
